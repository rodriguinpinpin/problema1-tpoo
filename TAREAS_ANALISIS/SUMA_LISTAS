def suma(valor, lista):
    
    if not lista:
        return 0
    
    primer_elemento = lista[0]
    restante = lista[1:]
    
    if primer_elemento >= valor:
        
        return primer_elemento + suma(valor, restante)
    else:
        
        return suma(valor, restante)

# Ejemplo de uso
numeros = [3, 8, 1, 10, 5, 2]
limite = 5

resultado = suma(limite, numeros)
print(f"La suma de los valores mayores o iguales a {limite} es: {resultado}")


